<?xml version="1.0" encoding="utf-8"?>
<!-- res/color/nav_item_color.xml
     Selected  → @color/main  (your teal/green)
     Default   → #1A1A1A      (near-black, unselected)
     No background highlight — just icon fill color changes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/main" android:state_checked="true" />
    <item android:color="#1A1A1A" />
</selector>
