<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_picker_media.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground">

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/picker_media_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/main" />

    <!-- Video duration badge (bottom left) -->
    <TextView
        android:id="@+id/picker_media_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/picker_duration_bg"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="0:30"
        tools:visibility="visible" />

    <!-- Dim overlay when selected -->
    <View
        android:id="@+id/picker_media_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Selection number circle (top right) -->
    <TextView
        android:id="@+id/picker_media_number"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/picker_selection_circle"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="1"
        tools:visibility="visible" />

    <!-- Unselected circle outline (top right, shown in multi mode) -->
    <View
        android:id="@+id/picker_media_unselected_circle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/picker_unselected_circle"
        android:visibility="gone" />

</FrameLayout>
