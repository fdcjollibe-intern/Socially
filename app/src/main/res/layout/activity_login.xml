<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_login.xml
    Fonts: res/font/poppins_regular, poppins_medium, poppins_bold
    Drawables needed:
      - default_bg        (your AVIF background)
      - ic_logo           (app logo icon)
      - ic_email          (envelope icon)
      - ic_lock           (lock icon)
      - ic_eye_off        (eye-slash icon)
      - ic_apple          (Apple logo icon)
      - bg_input_field    (see bg_input_field.xml)
      - bg_button_primary (see bg_button_primary.xml)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Splash-consistent background image (AVIF) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/default_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Card anchored toward the bottom, vertically centered -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="32dp"
        app:cardElevation="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.58">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <!-- Logo + Brand -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_logo"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Socially"
                    android:textSize="19sp"
                    android:textColor="#0D0D0D"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textSize="26sp"
                android:textColor="#0D0D0D"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log in to continue your journey"
                android:textSize="13sp"
                android:textColor="#9A9A9A"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="24dp" />

            <!-- Email Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="12sp"
                android:textColor="#0D0D0D"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginBottom="8dp" />

            <!-- Email Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_email"
                    android:alpha="0.45"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="hello@example.com"
                    android:hintTextColor="#CCCCCC"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:imeOptions="actionNext" />
            </LinearLayout>

            <!-- Password Label Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="#0D0D0D"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot?"
                    android:textSize="12sp"
                    android:textColor="#9A9A9A"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Password Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    android:alpha="0.45"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:hintTextColor="#CCCCCC"
                    android:textColor="#0D0D0D"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_eye_off"
                    android:alpha="0.45"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Log In Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Log In →"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EBEBEB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR CONTINUE WITH"
                    android:textSize="10sp"
                    android:textColor="#BBBBBB"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EBEBEB" />
            </LinearLayout>

            <!-- Social Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <!-- Google -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnGoogle"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    app:cardCornerRadius="27dp"
                    app:cardBackgroundColor="#F2F2F2"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="G"
                        android:textSize="17sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center" />
                </androidx.cardview.widget.CardView>

                <!-- Apple -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnApple"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    app:cardCornerRadius="27dp"
                    app:cardBackgroundColor="#F2F2F2"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_apple"
                        android:layout_gravity="center" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Sign Up Link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New to Socially? "
                    android:textSize="13sp"
                    android:textColor="#9A9A9A"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvJoinNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join now"
                    android:textSize="13sp"
                    android:textColor="#0D0D0D"
                    android:fontFamily="@font/poppins_bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
