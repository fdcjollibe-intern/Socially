<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cover Photo Skeleton -->
        <View
            android:id="@+id/skeleton_cover"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/skeleton_shimmer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Avatar Skeleton (overlapping) -->
        <View
            android:id="@+id/skeleton_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/skeleton_shimmer"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="@id/skeleton_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/skeleton_cover" />

        <!-- Name Skeleton -->
        <View
            android:id="@+id/skeleton_name"
            android:layout_width="150dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/skeleton_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_avatar" />

        <!-- Username Skeleton -->
        <View
            android:id="@+id/skeleton_username"
            android:layout_width="100dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/skeleton_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_name" />

        <!-- Bio Skeleton -->
        <View
            android:id="@+id/skeleton_bio"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/skeleton_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_username" />

        <!-- Stats Row Skeleton -->
        <LinearLayout
            android:id="@+id/skeleton_stats_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_bio">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <View
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:background="@drawable/skeleton_background" />
                <View
                    android:layout_width="35dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/skeleton_background" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="32dp" android:background="@color/gray_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <View
                    android:layout_width="45dp"
                    android:layout_height="20dp"
                    android:background="@drawable/skeleton_background" />
                <View
                    android:layout_width="55dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/skeleton_background" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="32dp" android:background="@color/gray_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <View
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:background="@drawable/skeleton_background" />
                <View
                    android:layout_width="55dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/skeleton_background" />
            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Skeleton -->
        <LinearLayout
            android:id="@+id/skeleton_action_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_stats_row">

            <View
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/skeleton_shimmer" />

            <View
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/skeleton_shimmer" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/skeleton_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/gray_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_action_buttons" />

        <!-- Grid Skeleton -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_divider">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_margin="1dp"
                    android:background="@drawable/skeleton_shimmer" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
