<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_post_detail.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/post_detail_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/post_detail_btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/user_profile_ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Post"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Divider under toolbar -->
    <View
        android:id="@+id/post_detail_toolbar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/gray_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_detail_toolbar" />

    <!-- Scrollable content — constrained above the comment input -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/post_detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/post_detail_comment_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_detail_toolbar_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Post card (reused layout) -->
            <include
                android:id="@+id/post_detail_card"
                layout="@layout/item_post_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Full caption -->
            <TextView
                android:id="@+id/post_detail_full_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Full caption goes here with all the details..." />

            <!-- Comments header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="Comments"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Comments list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/post_detail_comments_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Load more -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_detail_load_more"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="80dp"
                android:text="Load more"
                android:textColor="@color/gray"
                android:visibility="gone"
                app:strokeColor="@color/gray_border" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Thin divider above comment input -->
    <View
        android:id="@+id/post_detail_comment_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/gray_border"
        app:layout_constraintBottom_toTopOf="@id/post_detail_comment_input_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Comment input bar — pinned to bottom.
        Grows vertically as user types (maxLines=5, inputType=textMultiLine).
    -->
    <LinearLayout
        android:id="@+id/post_detail_comment_input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Your avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/user_profile_placeholder_avatar"
            app:civ_border_color="@color/accent"
            app:civ_border_width="1.5dp" />

        <!--
            EditText grows vertically on new lines.
            minLines=1, maxLines=5 — wraps text, never scrolls horizontally.
        -->
        <EditText
            android:id="@+id/post_detail_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:background="@drawable/comment_input_bg"
            android:hint="Write a comment…"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:textSize="13sp" />

        <!-- Send button -->
        <ImageButton
            android:id="@+id/post_detail_btn_send_comment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/post_card_ic_send"
            app:tint="@color/accent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
