<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <ImageView android:id="@+id/settings_row_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/user_profile_ic_menu" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/settings_row_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="8dp" android:textColor="@color/black" android:textSize="15sp" app:layout_constraintBottom_toTopOf="@id/settings_row_subtitle" app:layout_constraintEnd_toStartOf="@id/settings_row_value" app:layout_constraintStart_toEndOf="@id/settings_row_icon" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_chainStyle="packed" tools:text="Account privacy" />
    <TextView android:id="@+id/settings_row_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="8dp" android:textColor="@color/gray" android:textSize="12sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/settings_row_value" app:layout_constraintStart_toEndOf="@id/settings_row_icon" app:layout_constraintTop_toBottomOf="@id/settings_row_title" />
    <TextView android:id="@+id/settings_row_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:textColor="@color/gray" android:textSize="13sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/settings_row_chevron" app:layout_constraintTop_toTopOf="parent" />
    <ImageView android:id="@+id/settings_row_chevron" android:layout_width="16dp" android:layout_height="16dp" android:alpha="0.4" android:src="@drawable/user_profile_ic_chevron" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
