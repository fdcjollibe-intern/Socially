<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_register.xml
    Fonts: res/font/poppins_regular, poppins_medium, poppins_bold
    Drawables needed:
      - default_bg        (your AVIF background)
      - ic_logo           (app logo icon)
      - ic_user           (person/user icon)
      - ic_email          (envelope icon)
      - ic_lock           (lock icon)
      - ic_eye_off        (eye-slash icon)
      - bg_input_field    (see bg_input_field.xml)
      - bg_button_primary (see bg_button_primary.xml)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Splash-consistent background image (AVIF) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/default_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable content so keyboard doesn't break layout -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="48dp"
            android:paddingBottom="48dp">

            <!-- Floating Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRegister"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="32dp"
                app:cardElevation="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="32dp">

                    <!-- Logo + Brand -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="28dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_logo"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Socially"
                            android:textSize="19sp"
                            android:textColor="#0D0D0D"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>

                    <!-- Heading -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Account"
                        android:textSize="26sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start your journey with Socially"
                        android:textSize="13sp"
                        android:textColor="#9A9A9A"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginBottom="24dp" />

                    <!-- Full Name Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textSize="12sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Full Name Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_user"
                            android:alpha="0.45"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etFullName"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="John Doe"
                            android:hintTextColor="#CCCCCC"
                            android:textColor="#0D0D0D"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPersonName|textCapWords"
                            android:singleLine="true"
                            android:imeOptions="actionNext" />
                    </LinearLayout>

                    <!-- Email Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="12sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Email Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_email"
                            android:alpha="0.45"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="hello@example.com"
                            android:hintTextColor="#CCCCCC"
                            android:textColor="#0D0D0D"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:imeOptions="actionNext" />
                    </LinearLayout>

                    <!-- Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textSize="12sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Password Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_lock"
                            android:alpha="0.45"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Create a password"
                            android:hintTextColor="#CCCCCC"
                            android:textColor="#0D0D0D"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:imeOptions="actionNext" />

                        <ImageView
                            android:id="@+id/ivTogglePassword"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_eye_off"
                            android:alpha="0.45"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Confirm Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm Password"
                        android:textSize="12sp"
                        android:textColor="#0D0D0D"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Confirm Password Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_lock"
                            android:alpha="0.45"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Repeat your password"
                            android:hintTextColor="#CCCCCC"
                            android:textColor="#0D0D0D"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:imeOptions="actionDone" />

                        <ImageView
                            android:id="@+id/ivToggleConfirmPassword"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_eye_off"
                            android:alpha="0.45"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Terms notice -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="By joining, you agree to our Terms of Service and Privacy Policy."
                        android:textSize="11sp"
                        android:textColor="#AAAAAA"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:layout_marginBottom="18dp" />

                    <!-- Create Account Button -->
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Create Account →"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:background="@drawable/bg_button_primary"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="24dp" />

                    <!-- Login Link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Already have an account? "
                            android:textSize="13sp"
                            android:textColor="#9A9A9A"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Log in"
                            android:textSize="13sp"
                            android:textColor="#0D0D0D"
                            android:fontFamily="@font/poppins_bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
