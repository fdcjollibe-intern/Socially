    <item android:duration="200">
        <shape android:shape="oval">
            <solid android:color="#1a4d4d4d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <item android:duration="200">
        <shape android:shape="oval">
            <solid android:color="#4d4d4d4d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <item android:duration="200">
        <shape android:shape="oval">
            <solid android:color="#804d4d4d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <item android:duration="200">
        <shape android:shape="oval">
            <solid android:color="#b34d4d4d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <item android:duration="200">
        <shape android:shape="oval">
            <solid android:color="#4d4d4d" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
</animation-list>

