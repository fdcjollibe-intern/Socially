<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme — keeps your original Theme.Socially intact -->
    <style name="Base.Theme.Socially" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.Socially" parent="Base.Theme.Socially" />

    <!-- ── Squircle FAB ── -->
    <style name="ShapeAppearance.SquircleFAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28%</item>
    </style>

    <style name="Widget.App.SquircleFAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.SquircleFAB</item>
        <item name="backgroundTint">#000000</item>
        <item name="tint">@android:color/white</item>
    </style>

    <!-- ── Bottom nav — no active indicator pill ── -->
    <style name="NavActiveIndicatorHidden" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <!-- ── Post card bottom sheet rounded corners ── -->
    <style name="PostCardBottomSheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PostCardBottomSheetStyle</item>
    </style>

    <style name="PostCardBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/PostCardBottomSheetShape</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

    <style name="PostCardBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>