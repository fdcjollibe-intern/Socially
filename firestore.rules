rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-zA-Z0-9_]+$');
    }

    match /users/{userId} {

      // Read own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Also allow reading other users (needed for search, profile views)
      allow read: if request.auth != null;

      // Create on registration — uses displayName now
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'username'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && isValidUsername(request.resource.data.username);

      // Update own document (uid, email, createdAt are immutable)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'email', 'createdAt']);

      // No deletes
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'mediaUrls', 'caption', 'likesCount', 'commentsCount', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.mediaUrls is list
        && request.resource.data.mediaUrls.size() > 0
        && request.resource.data.caption is string
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'content', 'createdAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Following collection - users you follow
    match /following/{userId}/userFollowing/{followingId} {
      // Read your own following list
      allow read: if request.auth != null && request.auth.uid == userId;

      // Also allow others to read (for profile viewing)
      allow read: if request.auth != null;

      // Create: You can add someone to YOUR following list
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['userId', 'followedAt'])
        && request.resource.data.userId == followingId
        && request.resource.data.followedAt is timestamp;

      // Delete: You can remove from YOUR following list
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Followers collection - users who follow you
    match /followers/{userId}/userFollowers/{followerId} {
      // Read your own followers list
      allow read: if request.auth != null && request.auth.uid == userId;

      // Also allow others to read (for profile viewing)
      allow read: if request.auth != null;

      // Create: Someone can add themselves to YOUR followers (when they follow you)
      allow create: if request.auth != null
        && request.auth.uid == followerId
        && request.resource.data.keys().hasAll(['userId', 'followedAt'])
        && request.resource.data.userId == followerId
        && request.resource.data.followedAt is timestamp;

      // Delete: Someone can remove themselves from YOUR followers (when they unfollow you)
      allow delete: if request.auth != null && request.auth.uid == followerId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}